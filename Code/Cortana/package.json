{
  "name": "cortana",
  "version": "2.3.0",
  "description": "Electron frontend for Qwen 3.5",
  "main": "main.js",
  "scripts": {
    "start": "electron . --voice",
    "pack": "electron-packager . Cortana --platform=win32 --arch=x64 --overwrite",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.2.5",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "mic": "^2.1.2",
    "node-fetch": "^3.3.2",
    "onnxruntime-node": "^1.24.2",
    "remove-markdown": "^0.6.2",
    "sherpa-onnx": "^1.12.25",
    "undici": "^7.16.0",
    "wav": "^1.0.2"
  },
  "build": {
    "appId": "com.blackinkgames.cortanaremake",
    "productName": "Cortana",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "Images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  }
}
